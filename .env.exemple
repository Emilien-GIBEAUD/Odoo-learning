# 1. Copy, then rename this file in .env
# 2. Keep only what is necessary for your environment and container(s)
# 3. Enter your data and secrets
# 4. Move in the correct folder if necessary (pgAdmin in production only)

###> Development environment ###
# PostgreSQL database credentials
POSTGRES_USER=your_pg_user_here
POSTGRES_PASSWORD=your_pg_password_here

# pgAdmin credentials
PGADMIN_EMAIL=your_pgAdmin_user_here
PGADMIN_PASSWORD=your_pgAdmin_password_here

###> Development environment ###



###> Production environment ###
# in the .env file beside the compose.prod.yaml file 
# (for Odoo and PostgreSQL containers)

# PostgreSQL database credentials
POSTGRES_USER=your_pg_user_here
POSTGRES_PASSWORD=your_pg_password_here


### If you use pgAdmin in production ###
# in the .env file beside the pgAdmin compose.yaml file (in your pgAdmin folder)
# (for pgAdmin container)

# pgAdmin credentials
PGADMIN_EMAIL=your_pgAdmin_user_here
PGADMIN_PASSWORD=your_pgAdmin_password_here

###> Production environment ###
