        <br/>
        <h3>Votre réservation</h3>
            <table>
                <thead>
                    <tr>
                        <th style="text-align: left;"> Pizza </th>
                        <th style="text-align: left;">| Qtt </th>
                        <th style="text-align: left;">| Prix unit. </th>
                        <th style="text-align: left;">| Total </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="cart_total" t-value="0"/>
                    <t t-foreach="object.reservation_item_ids" t-as="item">
                        <tr class="align-middle">
                            <td style="text-align: left;" t-out="item.name"/>
                            <td style="text-align: left;" t-out="'| ' + str(item.quantity)"/>
                            <td style="text-align: left;" t-out="'| %.2f €' % item.unit_price"/>
                            <td style="text-align: left;" t-out="'| %.2f €' % (item.quantity * item.unit_price)"/>
                            <t t-set="cart_total" t-value="cart_total + item.quantity * item.unit_price"/>
                        </tr>
                    </t>
                </tbody>
            </table>
            <div class="mt-1 mb-5 text-end">
                <strong>Total : <span t-out="'%.2f €' % cart_total"/></strong>
            </div>
        <br/>
    </field>
</record>

</odoo>

