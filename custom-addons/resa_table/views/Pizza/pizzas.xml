<odoo>

<template id="pizzas_page" name="Pizzas">
    <t t-call="resa_table.base_template">
    <t t-call-assets="resa_table.assets_pizzas"/>
    <t t-set="page_title">Nos Pizzas</t>
    <div class="d-flex flex-column min-vh-100">
        <main class="flex-grow-1 col-11 col-xl-10 mx-auto">
            <div class="container mt-5">
                <h1 class="mb-4">Nos Pizzas</h1>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
                <a t-att-href="url_for('/resatable/conditions')">Voir les conditions</a>
                <hr class="my-4"/>
                <h2 class="mt-3">La carte</h2>
                <table class="table bg-body">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Ingrédients</th>
                            <th class="text-end">Prix (€)</th>
                        </tr>
                    </thead>
                    <tbody t-if="pizzas">
                        <tr t-foreach="pizzas" t-as="pizza">
                            <td t-out="pizza.name"/>
                            <td t-out="pizza.ingredients"/>
                            <td t-out="'%.2f' % pizza.price" class="text-end"/>
                        </tr>
                    </tbody>
                    <tbody t-else="">
                        <tr>
                            <td colspan="3">Pas de pizzas disponibles</td>
                        </tr>
                    </tbody>
                </table>

                <h2 class="mt-5">Notre service de réservation</h2>
                <t t-if="services">
                    <form method="post" action="" class="needs-validation" novalidate="">
                        <div class="row g-3">
                            <h4>Nos disponibilités</h4>
                            <div class="col-md-4"> 
                                <label class="form-label required" for="serviceDate">Nos services disponibles</label>
                                <select class="form-select" name="serviceDate" id="serviceDate">
                                    <t t-foreach="services" t-as="service">
                                        <option t-att-value="service.id">
                                            <t t-out="service.display_service"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4"> 
                                <label class="form-label required" for="serviceSlot">Choisissez votre horaire</label>
                                <select     class="form-select" name="serviceSlot" id="serviceSlot" data-selected-slot="">
                                    <!-- injected ?? OU PAS -->
                                    <t t-foreach="services" t-as="service">
                                        <t t-foreach="service.service_slot_ids" t-as="slot">
                                            <option t-att-value="slot.id" t-att-data-service-id="service.id">
                                                <t t-out="slot.display_slot"/>
                                            </option>
                                        </t>
                                    </t>
                                </select>
                            </div>

                            <hr class="my-2"/>
                            <h4>Votre panier</h4>
                            <table class="mt-1 table bg-body">
                                <thead>
                                    <tr>
                                        <th>Pizza</th>
                                        <th>Qtt</th>
                                        <th>Prix unit.</th>
                                        <th>Total</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="cartBody">
                                    <tr id="noItems">
                                        <td colspan="5" class="text-muted">
                                            Aucune pizza ajoutée.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="text-end">
                                <span id="cartTotalQuantity">0</span> pizza(s) dans le panier. <br/>
                                <strong>Total : <span id="cartTotal">0,00</span> €</strong>
                            </div>
                            <p class="alert alert-warning d-none" id="capacityAlert">
                                La capacité disponible pour ce créneau horaire est atteinte. Vous pouvez placer votre réservation en l'état mais pas ajouter de pizza.<br/>Le cas échéant, veuillez choisir un autre créneau, placer plusieurs réservations ou bien contactez-nous par téléphone.
                            </p>
                            <p class="alert alert-danger d-none" id="capacityExceededAlert">
                                La capacité du créneau selectionné est dépassée, veuillez ajuster votre panier ou bien sélectionner un autre créneau pour pouvoir placer votre réservation.
                            </p>

                            <div class="col-md-6"> 
                                <label class="form-label required" for="pizza">Votre pizza</label>
                                <select class="form-select" name="pizza" id="pizza">
                                        <option t-foreach="pizzas" t-as="pizza" t-att-value="pizza.id" t-att-data-name="pizza.name" t-att-data-price="pizza.price">
                                            <t t-out="pizza.name"/> (<td t-out="'%.2f' % pizza.price"/> €)
                                        </option>
                                </select>
                            </div>
                            <div class="col-md-2"> 
                                <label class="form-label required" for="quantity">Quantité</label>
                                <input type="number" class="form-control" name="quantity" id="quantity" value="1" min="1" max="5"/>
                            </div>
                            <div class="col-md-3 align-content-end"> 
                                <button type="button" id="addPizza" class="btn btn-primary">Ajouter au panier</button>
                            </div>

                            <hr class="my-2"/>
                            <h4>Vos coordonnées</h4>
                            <div class="col-sm-6">
                                <label for="firstName" class="form-label">Prénom</label> 
                                <input type="text" class="form-control" id="firstName" name="reservation[firstName]" placeholder="Votre prénom" value=""/>
                            </div>
                            <div class="col-sm-6">
                                <label for="lastName" class="form-label">Nom</label>
                                <input type="text" class="form-control" id="lastName" name="reservation[lastName]" placeholder="Votre nom" value=""/>
                            </div>
                            <div class="col-7">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="reservation[email]" placeholder="Votre email" value=""/>
                            </div>
                            <div class="col-5">
                                <label for="phone" class="form-label">Téléphone</label>
                                <input type="tel" class="form-control" id="phone" name="reservation[phone]" placeholder="06... ou 07... uniquement" value=""/>
                            </div>
                            <hr class="my-4"/>
                        </div>
                        <div class="d-flex justify-content-center">
                            <button type="submit" id="addBooking" class="btn btn-primary">Réserver</button>
                        </div>
                        <hr class="my-4"/>
                    </form>
                </t>
                <t t-else="">
                    <p>Aucun service n'est disponible pour le moment.</p>
                </t>
            </div>
        </main>
    </div>
    </t>
</template>

</odoo>
