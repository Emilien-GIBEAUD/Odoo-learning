<odoo>
<!-- Pizza -->
    <record id="pizza_list_view" model="ir.ui.view">
        <field name="name">resa_table.pizza.list</field>
        <field name="model">resa_table.pizza</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ingredients"/>
                <field name="price"/>
                <field name="isActive" class="text-center" width="45px"/>
            </list>
        </field>
    </record>

	<record id="pizza_form_view" model="ir.ui.view">
		<field name="name">resa_table.pizza.form</field>
		<field name="model">resa_table.pizza</field>

		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field name="ingredients"/>
						<field name="price"/>
						<field name="isActive"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="pizza_action" model="ir.actions.act_window">
		<field name="name">Pizzas</field>
		<field name="res_model">resa_table.pizza</field>
		<field name="view_mode">list,form</field>
	</record>


<!-- Service Templates -->
    <record id="service_template_list_view" model="ir.ui.view">
        <field name="name">resa_table.service_template.list</field>
        <field name="model">resa_table.service_template</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="startTime" widget="float_time"/>
                <field name="endTime" widget="float_time"/>
                <field name="slotDurationInMin" string="Créneau (min.)" width="95px"/>
                <field name="capacityPerSlot" string="Capacité"/>
                <field name="isActive" class="text-center" width="45px"/>
            </list>
        </field>
    </record>

	<record id="service_template_form_view" model="ir.ui.view">
		<field name="name">resa_table.service_template.form</field>
		<field name="model">resa_table.service_template</field>

		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field name="startTime" widget="float_time"/>
						<field name="endTime" widget="float_time"/>
						<field name="slotDurationInMin"/>
						<field name="capacityPerSlot"/>
						<field name="isActive"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="service_template_action" model="ir.actions.act_window">
		<field name="name">service_templates</field>
		<field name="res_model">resa_table.service_template</field>
		<field name="view_mode">list,form</field>
	</record>


<!-- Services -->
    <record id="service_list_view" model="ir.ui.view">
        <field name="name">resa_table.service.list</field>
        <field name="model">resa_table.service</field>

        <field name="arch" type="xml">
            <list>
				<field name="display_service"/>
                <field name="slotDurationInMin" string="Créneau (min.)" width="95px"/>
                <field name="capacityPerSlot" string="Capacité"/>
                <field name="bookingOpen" class="text-center" width="130px"/>
				<button name="slots"
						type="object"
						string="Créneaux"/>
				<button name="reservations"
						type="object"
						string="Réservations"/>
            </list>
        </field>
    </record>

	<record id="service_form_view" model="ir.ui.view">
		<field name="name">resa_table.service.form</field>
		<field name="model">resa_table.service</field>

		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field 	name="template_id"
								string="Utiliser un modèle"
								options="{'no_create': True, 'no_open': True}"/>
						<field name="startTime" widget="float_time"/>
						<field name="endTime" widget="float_time"/>
						<field name="slotDurationInMin"/>
						<field name="capacityPerSlot"/>
						<field name="bookingOpen"/>
						<field name="originTemplate"/>
						<button name="slots"
								type="object"
								string="Créneaux"/>
						<button name="reservations"
								type="object"
								string="Réservations"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="service_action" model="ir.actions.act_window">
		<field name="name">services</field>
		<field name="res_model">resa_table.service</field>
		<field name="view_mode">list,form</field>
	</record>

<!-- Menu -->
	<menuitem
		id="resatable_menu"
		name="ResaTable"/>
		<menuitem
			id="pizza_menu"
			name="Pizzas"
			parent="resatable_menu"
			action="pizza_action"
			sequence="10"/>

		<menuitem
			id="service_menu"
			name="Services"
			parent="resatable_menu"
			action="service_action"
			sequence="20"/>

		<menuitem
			id="service_template_menu"
			name="Modèles de service"
			parent="resatable_menu"
			action="service_template_action"
			sequence="30"/>

</odoo>
