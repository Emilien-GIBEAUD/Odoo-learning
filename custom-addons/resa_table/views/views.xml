<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="resa_table.list">
      <field name="name">ResaTable list</field>
      <field name="model">resa_table.resa_table</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="value"/>
          <field name="value2"/>
        </list>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="resa_table.action_window">
      <field name="name">ResaTable window</field>
      <field name="res_model">resa_table.resa_table</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- server action to the one above -->
    <record model="ir.actions.server" id="resa_table.action_server">
      <field name="name">ResaTable server</field>
      <field name="model_id" ref="model_resa_table_resa_table"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>

    <!-- Top menu item -->
    <menuitem name="ResaTable" id="resa_table.menu_root"/>
    <!-- menu categories -->
    <menuitem name="Menu 1" id="resa_table.menu_1" parent="resa_table.menu_root"/>
    <menuitem name="Menu 2" id="resa_table.menu_2" parent="resa_table.menu_root"/>
    <!-- actions -->
    <menuitem name="List" id="resa_table.menu_1_list" parent="resa_table.menu_1"
              action="resa_table.action_window"/>
    <menuitem name="Server to list" id="resa_table" parent="resa_table.menu_2"
              action="resa_table.action_server"/>
  </data>
</odoo>
