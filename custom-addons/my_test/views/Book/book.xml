<odoo>

<template id="book_page" name="Livre">
    <t t-call="my_test.base_template">
    <t t-set="page_title"><t t-out="book.name"/></t>
    <div class="d-flex flex-column min-vh-100">
        <main class="flex-grow-1 col-11 col-xl-10 mx-auto">
            <div class="container mt-5 mb-4">
                <h1 t-out="book.name"/>
                <p class="mb-2">
                    Auteur :
                    <a t-att-href="url_for('/bibliothèque/auteurs/%s' % book.author_id.id)">
                        <t t-out="book.author_id.name"/>
                    </a>
                </p>
                <p class="mb-2">
                    Année :
                    <span t-out="book.year"/>
                </p>
                <p class="mb-2" t-out="book.description"/>
            </div>
            <a t-att-href="url_for('/bibliothèque/livres')">retour à la liste des livres</a>
        </main>
    </div>
    </t>
</template>

</odoo>
