<odoo>
<!-- Book -->
    <record id="book_list_view" model="ir.ui.view">
        <field name="name">my_test.book.list</field>
        <field name="model">my_test.book</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author_id"/>
                <field name="year" options="{'enable_formatting': false}"/>
            </list>
        </field>
    </record>

	<record id="book_form_view" model="ir.ui.view">
		<field name="name">my_test.book.form</field>
		<field name="model">my_test.book</field>

		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field name="author_id"/>
						<field name="year" options="{'enable_formatting': false}"/>
						<field name="description"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="book_action" model="ir.actions.act_window">
		<field name="name">Livres</field>
		<field name="res_model">my_test.book</field>
		<field name="view_mode">list,form</field>
	</record>

<!-- author -->
    <record id="author_list_view" model="ir.ui.view">
        <field name="name">my_test.author.list</field>
        <field name="model">my_test.author</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="nationality_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

	<record id="author_form_view" model="ir.ui.view">
		<field name="name">my_test.author.form</field>
		<field name="model">my_test.author</field>

		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
						<field name="birth_date"/>
						<field name="nationality_ids" widget="many2many_tags"/>
						<field name="biography"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="author_action" model="ir.actions.act_window">
		<field name="name">Auteurs</field>
		<field name="res_model">my_test.author</field>
		<field name="view_mode">list,form</field>
	</record>

<!-- nationality -->
    <record id="nationality_list_view" model="ir.ui.view">
        <field name="name">my_test.nationality.list</field>
        <field name="model">my_test.nationality</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

	<record id="nationality_form_view" model="ir.ui.view">
		<field name="name">my_test.nationality.form</field>
		<field name="model">my_test.nationality</field>

		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="name"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="nationality_action" model="ir.actions.act_window">
		<field name="name">Nationalités</field>
		<field name="res_model">my_test.nationality</field>
		<field name="view_mode">list,form</field>
	</record>

<!-- Menu -->
	<menuitem
		id="library_menu"
		name="Bibliothèque"/>
		<menuitem
			id="book_menu"
			name="Livres"
			parent="library_menu"
			action="book_action"/>

		<menuitem
			id="author_menu"
			name="Auteurs"
			parent="library_menu"
			action="author_action"/>

		<menuitem
			id="nationality_menu"
			name="Nationalités"
			parent="library_menu"
			action="nationality_action"
			groups="base.group_system"/>

</odoo>
