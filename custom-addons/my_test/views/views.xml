<odoo>

    <record id="book_list_view" model="ir.ui.view">
        <field name="name">my_test.book.list</field>
        <field name="model">my_test.book</field>

        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="author"/>
                <field name="year" options="{'enable_formatting': false}"/>
            </list>
        </field>
    </record>

	<record id="book_form_view" model="ir.ui.view">
		<field name="name">my_test.book.form</field>
		<field name="model">my_test.book</field>

		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<field name="title"/>
						<field name="author"/>
						<field name="year" options="{'enable_formatting': false}"/>
						<field name="description"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="book_action" model="ir.actions.act_window">
		<field name="name">Livres</field>
		<field name="res_model">my_test.book</field>
		<field name="view_mode">list,form</field>
	</record>

	<menuitem
		id="book_menu"
		name="Livres"
		action="book_action"/>

</odoo>
