<odoo>

<template id="books_page" name="Livres">
    <t t-call="my_test.base_template">
    <t t-set="page_title">Les livres</t>
    <div class="d-flex flex-column min-vh-100">
        <main class="flex-grow-1 col-11 col-xl-10 mx-auto">
            <div class="container mt-5">
                <h1 class="mb-4">Les livres</h1>

                <table class="table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Auteur</th>
                            <th>Année</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr t-foreach="books" t-as="book">
                            <td t-out="book.name"/>
                            <td t-out="book.author_id.name"/>
                            <td t-out="book.year"/>
                            <td>
                                <a t-att-href="url_for('/bibliothèque/livres/%s' % book.id)">
                                    Voir
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
    </t>
</template>

</odoo>
